public/
resources/
.hugo_build.lock
*.pdf
_DS_Store
/assets
PJordano-Lab.code-workspace
redirect_kit/

/.quarto/
# CLAUDE.md
# thumbnails regenerated by the photo-gallery extension on render
photos/**/thumbs/

# API keys read by fetch-wos-stats.py (WOS_API_KEY) and friends: never commit
.Renviron

# macOS / R / Python scratch that kept showing up as untracked
.DS_Store
**/.DS_Store
.RData
.Rhistory
__pycache__/
**/__pycache__/

# Screenshots written by _tools/page-shots.py (local verification only)
_screenshots/

# DataCite lookup cache written by _tools/propose-paper-links.py
data/.datacite_cache.json

# LaTeX build logs from the CV
**/cv/*.log
**/texput.log
# the CV source must be in the repo: CI re-renders the site and can only
# publish docs/cv/cv.pdf if cv/cv.pdf is checked out
!cv/cv.pdf

# Build output. GitHub Actions (.github/workflows/static.yml) runs
# `quarto render` on every push and deploys the docs/ it just built, so the
# rendered site does not belong in the repository. Requires Settings > Pages
# > Source = "GitHub Actions" (not "Deploy from a branch").
# Render locally with `quarto render` / `quarto preview` to check changes.
/docs/

